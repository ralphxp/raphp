{
  "name": "raphp/raphp",
  "description": "Raphp: an async PHP runtime with an optional native GUI. Placeholder package name until publishing.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Rapha Panchi",
      "email": "raphapanchi@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "ext-ffi": "*",
    "ext-json": "*",
    "ext-pcntl": "*",
    "ext-posix": "*",
    "ext-sockets": "*",
    "amphp/amp": "^3",
    "amphp/byte-stream": "^2",
    "amphp/pipeline": "^1",
    "monolog/monolog": "^3.12",
    "php-di/php-di": "^7.1",
    "psr/clock": "^1.0",
    "psr/container": "^2.0",
    "psr/event-dispatcher": "^1.0",
    "psr/log": "^3.0",
    "revolt/event-loop": "^1"
  },
  "autoload": {
    "psr-4": {
      "Raphp\\": "php/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Raphp\\Tests\\": "php/tests/",
      "Raphp\\Examples\\HeadlessWorker\\": "examples/headless-worker/src/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.3",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.1",
    "phpunit/phpunit": "^13.4",
    "spaze/phpstan-disallowed-calls": "^4.15"
  }
}
